# Wiki figure style. Tier 3, synthesis.
# Load with: plt.style.use(Path(__file__).parent / "wiki.mplstyle")
# Colours are the validated three-slot categorical palette. Hex carries no
# leading hash here, because '#' starts a comment in a matplotlib style file.

figure.facecolor:   fcfcfb
axes.facecolor:     fcfcfb
savefig.facecolor:  fcfcfb
figure.dpi:         160
savefig.bbox:       tight

font.family:        sans-serif
font.sans-serif:    Segoe UI, DejaVu Sans, Arial, sans-serif
font.size:          9

axes.prop_cycle:    cycler('color', ['2a78d6', 'eb6834', '1baf7a'])

axes.spines.top:    False
axes.spines.right:  False
axes.edgecolor:     c3c2b7
axes.linewidth:     0.8
axes.labelcolor:    52514e
axes.labelsize:     9
axes.titlecolor:    0b0b0b
axes.titlesize:     10.5
axes.titleweight:   normal
axes.titlelocation: left
axes.titlepad:      10

axes.grid:          True
axes.grid.axis:     y
grid.color:         e1e0d9
grid.linewidth:     0.7
grid.alpha:         1.0

xtick.color:        c3c2b7
ytick.color:        c3c2b7
xtick.labelcolor:   898781
ytick.labelcolor:   898781
xtick.labelsize:    8
ytick.labelsize:    8
xtick.direction:    out
ytick.direction:    out
xtick.major.size:   3
ytick.major.size:   3

lines.linewidth:      2.0
lines.markersize:     6
lines.solid_capstyle: round

legend.frameon:     False
legend.fontsize:    8

svg.fonttype:       none
